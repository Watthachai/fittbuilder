{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportSessionId",
    "deliveryId",
    "snapshotRevision",
    "operation",
    "builderProjectId",
    "stage",
    "sentAt",
    "source",
    "review",
    "content",
    "evidence",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "fittbuilder.delivery.v1"
    },
    "exportSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "deliveryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "snapshotRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "operation": {
      "enum": [
        "CREATE_PROJECT",
        "UPDATE_PROJECT"
      ]
    },
    "builderProjectId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "enum": [
        "DRAFT",
        "REVIEWED"
      ]
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordingId",
        "transcriptVersionId",
        "transcriptKind",
        "summaryId",
        "requirementId",
        "requirementRevision",
        "capturedAt"
      ],
      "properties": {
        "recordingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "transcriptVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "transcriptKind": {
          "enum": [
            "CLEANED",
            "LIVE_STABLE"
          ]
        },
        "summaryId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "requirementId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "requirementRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "capturedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requirementId": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "requirementRevision": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "requirementRevision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewerRef",
            "reviewedAt",
            "approvalId"
